<div class="container">
<p style="color: green"><%= notice %></p>
<h1><%= @movie.title %></h1>
  
  <ul class="movie-details">
    <li>
      <strong>Rating:</strong>
      <%= @movie.rating %>
    </li>
    <li>
      <strong>Released:</strong>
      <%= l(@movie.release_date) if @movie.release_date %>
    </li>
  </ul>
  
  <br>
  
  <%= link_to "Edit this movie", edit_movie_path(@movie), class: "btn" %>
  <%= link_to "Back to movies", root_path, class: "btn btn-secondary" %>
</div>
