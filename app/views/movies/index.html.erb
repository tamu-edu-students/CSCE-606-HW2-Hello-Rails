<div class="container">
  <p style="color: green"><%= notice %></p>
  <% content_for :title, "Movies" %>
  <h1>Movies</h1>
  <table>
    <thead>
      <tr>
        <th class="<%= sorted_column_class('title') %>">
          <%= sortable "title", "Movie Title" %>
        </th>
        <th class="<%= sorted_column_class('rating') %>">
          <%= sortable "rating" %>
        </th>
        <th class="<%= sorted_column_class('release_date') %>">
          <%= sortable "release_date", "Release Date" %>
        </th>
        <th>
          More Info
        </th>
      </tr>
    </thead>

    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td class="<%= sorted_column_class('title') %>">
            <%= movie.title %>
          </td>
          <td class="<%= sorted_column_class('rating') %>">
            <%= movie.rating %>
          </td>
          <td class="<%= sorted_column_class('release_date') %>">
            <%= l(movie.release_date, format: :long) if movie.release_date %>
          </td>
          <td>
            <%= link_to "More Info", movie_path(movie) %>
          </td>
        </tr>
      <% end %>
    </tbody>

    <tfoot>
      <tr>
        <td colspan="4">
          <%= paginate @movies %>
        </td>
      </tr>
    </tfoot>
  </table>

  <br>
  <%= link_to "New Movie", new_movie_path %>
</div>
